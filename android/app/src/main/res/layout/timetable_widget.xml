<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:maxLines="1" android:ellipsize="end" android:text="今日课程" android:textSize="16sp" android:textStyle="bold" android:textColor="#272B27" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
            android:text="BITree" android:textSize="12sp" android:textStyle="bold" android:textColor="#A85E3E" />
    </LinearLayout>
    <TextView android:id="@+id/widget_message" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="打开 BITree 查看课表" android:textSize="12sp" android:textColor="#62665F" />
    <TextView android:id="@+id/course_one" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:maxLines="2" android:ellipsize="end" android:textSize="12sp" android:textColor="#344C35" />
    <TextView android:id="@+id/course_two" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:maxLines="2" android:ellipsize="end" android:textSize="12sp" android:textColor="#344C35" />
    <TextView android:id="@+id/course_three" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:maxLines="2" android:ellipsize="end" android:textSize="12sp" android:textColor="#344C35" />
</LinearLayout>
